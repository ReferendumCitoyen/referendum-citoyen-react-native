# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# local scratch files
_local/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# But DO track the bundled ICAO master list — utils/csca-bootstrap.ts loads
# it as an Expo asset at runtime to register CSCAs that aren't on chain yet.
!assets/certificates/*.pem
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/

# local env files
.env
.env*.local
secrets/

# downloaded build artifacts
*.ipa

# personal working notes & local audit logs (e.g. TODO.local.md, eas-builds.local.log)
*.local.md
*.local.log
notes/

# Shared planning / audit documents dropped into the repo root for reference
# (DPIA action lists, feedback rounds, legal review PDFs). They are working
# documents that circulate outside the repo, frequently carry names and
# unpublished decisions, and have no build-time consumer. No PDF has ever been
# tracked here, so this is a catch-all rather than a per-file entry.
*.pdf

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# export folders (reference implementations from other projects)
/french-id-scan-export
/passport-scan-export

# build outputs (all levels)
build/
**/build/
# Keep plugin build outputs (needed for Expo config plugins)
!plugins/**/build/
!modules/**/plugin/build/
coverage/
**/coverage/

# caches (all levels)
.cache/
**/.cache/
.gradle/
**/.gradle/
# Android NDK / CMake out-of-source build dirs (per-ABI Ninja graphs +
# CMakeFiles). Regenerated by Gradle's externalNativeBuild on every build.
.cxx/
**/.cxx/
.turbo/
**/.turbo/
.parcel-cache/
**/.parcel-cache/
tmp/
**/tmp/
temp/
**/temp/

.claude
CLAUDE.md
.nvmrc

# Local SDK tarballs (e.g. rarimo-rarime-rn-sdk-0.3.1.tgz, 50 MB binary).
# package.json references the npm registry version; the .tgz isn't a
# dependency. Keeping it untracked locally is fine for one-off testing
# but it must not be committed — both because of the size and because
# a local-tarball install can bypass the supply-chain controls of the
# registry path.
*.tgz

# Passport data files (personal data): never commit.
example-passport*.json

# Proof dumps written by utils/heavy-proof-dump.ts on every __DEV__ prove().
# They pile up at the repo root and carry a per-document passportHash and BJJ
# identityKey in pub_signals — diagnostic artifacts, not source, and not things
# to hand around. Also keeps them out of what EAS uploads.
heavy-proof-*.json

# Local build/commit activity log (generated by eas build:list)
eas-log.jsonl

# Local native-library rebuild workspace (16 KB page-size builds)
.native-build/

# Native-build artifacts (the aligned .so is installed into jniLibs / committed separately)
scripts/native-build/*/out/

# Screen recordings and screenshots dropped at the repo root while debugging.
# They are nobody's source, and until they were ignored `git status --porcelain`
# reported the tree dirty — which app.config.ts turns into the "-dirty" suffix
# on the commit shown in Settings and in every error report, and which EAS
# uploads along with the build. Build 21 went out as 7bddd23745-dirty for
# exactly this reason. Listed by name rather than by extension so a real asset
# of the same kind is not hidden by accident.
/IMG_3727 2.mov
/image.png

# Local tester notes, not part of any build. Untracked, it made every EAS
# upload a "-dirty" commit, which the store build's commit label must not be.
TESTER-INSTRUCTIONS.md

# Local iOS simulator QA harness. Untracked on purpose: these scripts default
# to absolute paths under the operator's own scratch directory, which carry a
# user name and a tooling session id. A `git add -A` committed them once by
# accident; ignoring them means it cannot happen twice. Remove this entry only
# once the scripts take those paths from the environment.
qa/ios-sim/

# Maestro campaign output: screenshots written inside the repository by the
# test runners. None of it is source and none of it is published.
qa/maestro/out/

# --- Personal data produced by the app or its dev tools. Never commit. ---
# Voting-key backups from "Gestion des clés": a private key that proves how
# its holder voted.
referendum-citoyen-cle*.json
referendum-citoyen-keys-*.json
*passport-key*.json
# Error and vote reports (beta reports carry unredacted vote data).
vote-artifacts-*.json
vote-report-*.txt
error-report-*.txt
# Photos, screen recordings and data exports dropped at the repository root.
# Root-anchored, so nothing under assets/ is affected.
/IMG_*
/*.heic
/*.HEIC
/*.mov
/*.mp4
/*.jpg
/*.jpeg
/*.png
/Screen*Recording*
/ScreenRecording*
/Screenshot*
/*.csv
/*.xlsx

