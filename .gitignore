# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# But DO track the bundled ICAO master list — utils/csca-bootstrap.ts loads
# it as an Expo asset at runtime to register CSCAs that aren't on chain yet.
!assets/certificates/*.pem
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/

# local env files
.env*.local

# personal working notes & local audit logs (e.g. TODO.local.md, eas-builds.local.log)
*.local.md
*.local.log
notes/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# export folders (reference implementations from other projects)
/french-id-scan-export
/passport-scan-export

# build outputs (all levels)
build/
**/build/
# Keep plugin build outputs (needed for Expo config plugins)
!plugins/**/build/
!modules/**/plugin/build/
coverage/
**/coverage/

# caches (all levels)
.cache/
**/.cache/
.gradle/
**/.gradle/
# Android NDK / CMake out-of-source build dirs (per-ABI Ninja graphs +
# CMakeFiles). Regenerated by Gradle's externalNativeBuild on every build.
.cxx/
**/.cxx/
.turbo/
**/.turbo/
.parcel-cache/
**/.parcel-cache/
tmp/
**/tmp/
temp/
**/temp/
