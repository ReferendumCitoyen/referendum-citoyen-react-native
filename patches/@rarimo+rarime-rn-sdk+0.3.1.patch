+//   length = byteLen*8 + 1 + 64
+//   chunks = ceil(length / chunkSize)
+export function getChunkNumber(byteLen: number, chunkSizeBits: number): number {
+  const lengthBits = byteLen * 8 + 1 + 64;
+  return Math.ceil(lengthBits / chunkSizeBits);
+}
+
+// Compute hash bytes for a CircuitPassportHashType. Used to find DG1 / DG15
+// hashes inside the encapsulated content.
+export function hashWith(algo: CircuitPassportHashType, data: Uint8Array): Uint8Array {
+  switch (algo) {
+    case CircuitPassportHashType.SHA1: return sha1(data);
+    case CircuitPassportHashType.SHA224: return sha224(data);
+    case CircuitPassportHashType.SHA256: return sha256(data);
+    case CircuitPassportHashType.SHA384: return sha384(data);
+    case CircuitPassportHashType.SHA512: return sha512(data);
+  }
+}
+
+// The complete resolver. Given the parsed components, produces a fully-named
+// suite or returns null with a reason if the passport isn't supported.
+//
+// Inputs the caller must extract from the SOD using existing SDK methods:
+//   - slaveCert            : pickSlaveCertificate(passport.getCertificate())
+//   - sodSignatureOid      : passport.getSignatureAlgorithm()
+//   - dgHashOid            : passport.extractDGHashAlgo()
+//   - encapsulatedContent  : passport.extractEncapsulatedContent()
+//   - signedAttributes     : passport.extractSignedAttributes()
+//   - dg1                  : passport.dataGroup1
+//   - dg15                 : passport.dataGroup15 (or undefined)
+//
+// Note on AA: Active-Authentication suite resolution is more involved (DG15
+// pubkey type depends on the AA algorithm). For Phase A.1 we resolve only the
+// non-AA path; passports with DG15 will return null until Phase A.3.
+export function resolveCircuitSuite(args: {
+  slaveCert: Certificate;
+  sodSignatureOid: string;
+  dgHashOid: string;
+  encapsulatedContent: Uint8Array;
+  signedAttributes: Uint8Array;
+  dg1: Uint8Array;
+  dg15?: Uint8Array;
