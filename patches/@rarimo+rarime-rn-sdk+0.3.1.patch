+}): { suite: RegisterIdentityCircuitType; signatureTypeId: number } | { error: string } {
+  // 1) Hash algorithm used for DG hashes (passport hash type)
+  const passportHashType = passportHashTypeFromOID(args.dgHashOid);
+
+  // 2) Signature algorithm + cert pubkey details
+  const sodSig = fromSodSignatureOID(args.sodSignatureOid);
+  const certPubkey = extractSignatureSuiteFromCert(args.slaveCert);
+
+  // Reconcile algorithm — sodSig.circuitSignature should match certPubkey.algorithm.
+  if (sodSig.circuitSignature !== certPubkey.algorithm) {
+    return { error: `algorithm mismatch: sod=${sodSig.circuitSignature}, cert=${certPubkey.algorithm}` };
+  }
+  if (certPubkey.keySize === null) {
+    return { error: "cert key size not in supported set" };
+  }
