+// Lookup the staticId for a given (algo, keySize, exponent, salt, curve, hashAlgo)
+// tuple. Returns null if no row matches — that means the passport's signature
+// suite isn't supported by Rarimo's published heavy-register circuits.
+export function getSupportedSignatureTypeId(candidate) {
+    const match = SUPPORTED_SIGNATURE_TYPES.find((row) => row.algorithm === candidate.algorithm &&
+        row.keySize === candidate.keySize &&
+        row.exponent === candidate.exponent &&
+        row.salt === candidate.salt &&
+        row.curve === candidate.curve &&
+        row.hashAlgorithm === candidate.hashAlgorithm);
+    return match ? match.staticId : null;
+}
+// 5 entries (1 RSA + 4 ECDSA) for Active Authentication algorithms. Used only
+// when the passport has a non-empty DG15.
+export const SUPPORTED_AA_TYPES = [
+    // RSA fallback
+    { staticId: 1, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B1024, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: null },
+    // ECDSA AA variants
+    { staticId: 20, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP256R1, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+    { staticId: 21, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP256R1, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+    { staticId: 22, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP320R1, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+    { staticId: 23, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP192R1, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+    { staticId: 24, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP384R1, hashAlgorithm: CircuitHashAlgorithm.HA384 },
+];
+// Match an AA row by (algorithm, hashAlgorithm, curve). Mirrors the iOS
+// SupportRegisterIdentityCircuitAAType.getSupportedSignatureTypeId logic,
+// including its RSA fallback to staticId=1 when no other row matches.
+export function getSupportedAATypeId(candidate) {
+    const match = SUPPORTED_AA_TYPES.find((row) => row.algorithm === candidate.algorithm &&
+        row.hashAlgorithm === candidate.hashAlgorithm &&
+        row.curve === candidate.curve);
+    if (match)
+        return match.staticId;
+    // iOS fallback: any RSA AA without an exact row defaults to staticId=1.
+    if (candidate.algorithm === CircuitAlgorithm.RSA)
+        return 1;
+    return null;
+}
