--- a/node_modules/@rarimo/rarime-rn-sdk/ios/Swoir/SwoirCore.swift
+++ b/node_modules/@rarimo/rarime-rn-sdk/ios/Swoir/SwoirCore.swift
@@ -33,3 +33,34 @@ public enum SwoirCore {
       static func execute(bytecode: Data, witnessMap: [String]) throws -> [String]
   }
 }
+
+// Patched (patches/@rarimo+rarime-rn-sdk+0.3.1.patch). A bare Swift enum has
+// no localizedDescription, so every one of the cases above reached JS as
+// "The operation couldn't be completed. (RnNoir.SwoirCore.SwoirBackendError
+// error 0.)" — the ordinal of the case and nothing else. The String each case
+// carries is the only thing that says WHICH constraint the circuit failed, and
+// it was being thrown away at the bridge.
+//
+// That cost a night: on 2026-09-09 two circuits failed on two phones and the
+// error reports could say only "error 0", which is `errorProving`. Conforming
+// to LocalizedError makes the payload the localizedDescription, so it survives
+// into the report and names the assert. Android already behaves this way — a
+// JVM exception keeps its message.
+extension SwoirCore.SwoirBackendError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .errorProving(let detail): return "proving failed: \(detail)"
+        case .errorVerifying(let detail): return "verifying failed: \(detail)"
+        case .errorExecuting(let detail): return "witness solving failed: \(detail)"
+        case .networkError(let detail): return "network error: \(detail)"
+        case .memoryLimitExceeded: return "memory limit exceeded"
+        case .invalidBytecode: return "invalid circuit bytecode"
+        case .emptyBytecode: return "empty circuit bytecode"
+        case .emptyWitnessMap: return "empty witness map"
+        case .emptyProofData: return "empty proof data"
+        case .emptyVerificationKey: return "empty verification key"
+        case .emptyProofType: return "empty proof type"
+        case .errorSettingUpSRS: return "could not set up the SRS"
+        }
+    }
+}
