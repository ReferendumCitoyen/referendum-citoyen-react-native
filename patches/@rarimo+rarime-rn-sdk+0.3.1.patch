+  return {
+    suite: {
+      signatureType: { ...candidate, staticId: signatureTypeId },
+      passportHashType,
+      documentType,
+      ecChunkNumber,
+      ecDigestPosition,
+      dg1DigestPositionShift,
+      aaType,
+    },
+    signatureTypeId,
+  };
+}
