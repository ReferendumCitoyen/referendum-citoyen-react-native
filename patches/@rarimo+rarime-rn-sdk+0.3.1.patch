--- /dev/null
+++ b/node_modules/@rarimo/rarime-rn-sdk/src/helpers/circuitValidation.ts
@@ -0,0 +1,99 @@
+// Circuit JSON validation for the atomic circuit cache (dossier 2.0.2, item
+// 15 / R9; plan D12).
+//
+// Validates the whole JSON incrementally and requires a non-empty top-level
+// "bytecode" string, without building the parsed object beside its source.
+// Yields a macrotask every 16 ms, and pauses entirely while the gate says no
+// (the app closes it while an NFC read owns the phone). Nothing from the file
+// is ever logged.
+let gate: () => boolean = () => true;
+
+/** The app sets this once: validation pauses while it returns false. */
+export const setCircuitValidationGate = (fn: () => boolean): void => {
+  gate = fn;
+};
+
+const fail = (): never => {
+  throw new Error("CIRCUIT_UNAVAILABLE");
+};
+
+export async function validateCircuitJson(text: string): Promise<void> {
+  let i = 0;
+  let lastYield = Date.now();
+  let bytecode = false;
+  const whitespace = () => {
+    while (i < text.length && /[ \t\r\n]/.test(text[i])) i++;
+  };
+  async function yieldIfNeeded() {
+    if (!gate() || Date.now() - lastYield >= 16) {
+      do {
+        await new Promise((r) => setTimeout(r, gate() ? 0 : 50));
+      } while (!gate());
+      lastYield = Date.now();
+    }
+  }
+  async function string(capture = false): Promise<string | boolean> {
+    if (text[i++] !== '"') fail();
+    const start = i - 1;
+    while (i < text.length) {
+      const c = text[i++];
+      if (c === '"') return capture ? JSON.parse(text.slice(start, i)) : i - start > 2;
+      if (c.charCodeAt(0) < 32) fail();
+      if (c === "\\") {
+        const escape = text[i++];
+        if (escape === "u") {
+          if (!/^[\da-f]{4}$/i.test(text.slice(i, i + 4))) fail();
+          i += 4;
+        } else if (!escape || !'"\\/bfnrt'.includes(escape)) fail();
+      }
+      if (i % 4096 < 6) await yieldIfNeeded();
+    }
+    return fail();
+  }
+  async function value(depth = 0, isBytecode = false): Promise<void> {
+    if (depth > 200) fail();
+    await yieldIfNeeded();
+    whitespace();
+    const c = text[i];
+    if (c === '"') {
+      const nonEmpty = await string();
+      if (isBytecode) bytecode = nonEmpty === true;
+      return;
+    }
+    if (isBytecode) fail();
+    if (c === "{" || c === "[") {
+      const object = c === "{";
+      const end = object ? "}" : "]";
+      i++;
+      whitespace();
+      if (text[i] === end) {
+        i++;
+        return;
+      }
+      for (;;) {
+        let key: string | boolean | undefined;
+        if (object) {
+          whitespace();
+          key = await string(depth === 0);
+          whitespace();
+          if (text[i++] !== ":") fail();
+        }
+        await value(depth + 1, depth === 0 && key === "bytecode");
+        whitespace();
+        if (text[i] === end) {
+          i++;
+          return;
+        }
+        if (text[i++] !== ",") fail();
+      }
+    }
+    const match = text
+      .slice(i, i + 128)
+      .match(/^(?:true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/);
+    if (!match) fail();
+    i += match![0].length;
+  }
+  await value();
+  whitespace();
+  if (i !== text.length || !bytecode) fail();
+}
