+// Atomic, validated circuit cache (dossier 2.0.2, item 15 / R9; plan D12,
+// merged with the app's markers).
+//
+// The SDK used to download straight to the final name and trust any file
+// present there, so a download interrupted at 670 KB left a bytecode file that
+// every later launch reported as cached and the proof failed on for ever
+// (2026-09-19T17-02-53-549Z). Now:
+//   - a download goes to `<name>.partial`, is checked, and only then renamed;
+//   - a cached bytecode is trusted when its `.ok` marker holds its size (the
+//     marker the app's utils/circuit-preload.ts writes too), else validated
+//     once and the marker written; a bytecode that fails is deleted and
+//     fetched again;
+//   - the trusted setup (150 to 300 MB) is never read in JavaScript: its size
+//     is compared with the `.size` marker. A setup from before the markers,
+//     without one, is kept if it is at least 50 MB (the app's rule), so no
+//     one downloads 300 MB again because of this update.
+import * as FileSystem from "expo-file-system/legacy";
+import { validateCircuitJson } from "./circuitValidation";
+const MIN_TRUSTED_SETUP_BYTES = 50 * 1024 * 1024;
+const downloads = new Map();
+const okMarker = (uri) => uri + ".ok";
+const sizeMarker = (uri) => uri + ".size";
+async function readSmall(uri) {
+    try {
+        const info = await FileSystem.getInfoAsync(uri);
+        if (!info.exists)
+            return null;
+        return await FileSystem.readAsStringAsync(uri);
+    }
+    catch {
+        return null;
+    }
+}
+async function removeQuietly(uri) {
+    try {
+        await FileSystem.deleteAsync(uri, { idempotent: true });
+    }
+    catch { }
+}
+/** True when the file at `uri` can be handed to the prover as is. */
+export async function validCircuitFile(uri, bytecode) {
+    const info = await FileSystem.getInfoAsync(uri);
+    if (!info.exists)
+        return false;
+    const size = info.size ?? 0;
+    try {
+        if (!bytecode) {
+            const recorded = parseInt((await readSmall(sizeMarker(uri))) ?? "", 10);
+            return Number.isFinite(recorded) && recorded > 0
+                ? size === recorded
+                : size >= MIN_TRUSTED_SETUP_BYTES;
+        }
+        if ((await readSmall(okMarker(uri))) === String(size))
+            return true;
+        await validateCircuitJson(await FileSystem.readAsStringAsync(uri));
+        await FileSystem.writeAsStringAsync(okMarker(uri), String(size));
+        return true;
+    }
+    catch {
+        return false;
+    }
+}
+/**
+ * The file at `uri`, downloaded from `url` if the cached one is missing or
+ * invalid. Concurrent calls for the same file share one download. Throws
+ * [CIRCUIT_UNAVAILABLE] when the download is incomplete or invalid; nothing
+ * is published under `uri` then.
+ */
+export async function atomicCircuitDownload(url, uri, bytecode, progress) {
+    const running = downloads.get(uri);
+    if (running)
+        return running;
+    const work = (async () => {
+        if (await validCircuitFile(uri, bytecode))
+            return uri;
+        await removeQuietly(uri);
+        await removeQuietly(bytecode ? okMarker(uri) : sizeMarker(uri));
+        const temporary = uri + ".partial";
+        await removeQuietly(temporary);
+        let expected = 0;
+        try {
+            const result = await FileSystem.createDownloadResumable(url, temporary, {}, (p) => {
+                if (p.totalBytesExpectedToWrite > 0)
+                    expected = p.totalBytesExpectedToWrite;
+                progress?.(p);
+            }).downloadAsync();
+            if (!result || result.status !== 200)
+                throw new Error("[CIRCUIT_UNAVAILABLE] download failed");
+            const headers = result.headers || {};
+            expected = Number(headers["Content-Length"] || headers["content-length"]) || expected;
+            const info = await FileSystem.getInfoAsync(temporary);
+            const size = info.exists ? info.size ?? 0 : 0;
+            if (!info.exists || (expected > 0 && size !== expected)) {
+                throw new Error("[CIRCUIT_UNAVAILABLE] download truncated");
+            }
+            if (bytecode) {
+                try {
+                    await validateCircuitJson(await FileSystem.readAsStringAsync(temporary));
+                }
+                catch {
+                    throw new Error("[CIRCUIT_UNAVAILABLE] bytecode invalid");
+                }
+            }
+            else if (size < MIN_TRUSTED_SETUP_BYTES) {
+                throw new Error("[CIRCUIT_UNAVAILABLE] trusted setup too small");
+            }
+            // Marker first: a crash between the two leaves a marker without a
+            // file, which reads as "not cached".
+            await FileSystem.writeAsStringAsync(bytecode ? okMarker(uri) : sizeMarker(uri), String(size));
+            await FileSystem.moveAsync({ from: temporary, to: uri });
+            return uri;
+        }
+        finally {
+            await removeQuietly(temporary);
+        }
+    })();
+    downloads.set(uri, work);
+    try {
+        return await work;
+    }
+    finally {
+        if (downloads.get(uri) === work)
+            downloads.delete(uri);
+    }
+}
