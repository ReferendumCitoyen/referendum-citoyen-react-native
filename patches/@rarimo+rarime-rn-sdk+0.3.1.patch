+// Static lookup tables for the Rarimo registerIdentity circuit family.
+// Mirrors:
+//   rarime-ios-app/Rarime/Code/Models/Circuits/SupportRegisterIdentityCircuitSignatureType.swift
+//   rarime-ios-app/Rarime/Code/Models/Circuits/SupportRegisterIdentityCircuitAAType.swift
+//
+// Adding a new row here only matters if Rarimo publishes a new Noir circuit
+// for that signature suite — until then, these IDs aren't valid filename
+// components.
+
+import {
+  CircuitAlgorithm,
+  CircuitKeySize,
+  CircuitExponent,
+  CircuitSalt,
+  CircuitCurve,
+  CircuitHashAlgorithm,
+  CircuitSignatureType,
+  CircuitAAAlgorithm,
+} from "./CircuitSuite";
+
+// 28 entries: 8 RSA + 6 RSA-PSS + 14 ECDSA. The numbering is owned by Rarimo
+// and shows up in every registerIdentity_<id>_... filename.
+export const SUPPORTED_SIGNATURE_TYPES: CircuitSignatureType[] = [
+  // ── RSA (PKCS#1 v1.5) ──────────────────────────────────────────────────
+  { staticId: 1, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 2, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B4096, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 3, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 4, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B3072, exponent: CircuitExponent.E37187, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 5, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA512 },
+  { staticId: 6, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E58333, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 7, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B3072, exponent: CircuitExponent.E45347, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 8, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B3072, exponent: CircuitExponent.E46271, salt: null, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+
+  // ── RSA-PSS ────────────────────────────────────────────────────────────
+  { staticId: 10, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E3,     salt: CircuitSalt.S32, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 11, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: CircuitSalt.S32, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 12, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: CircuitSalt.S64, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 13, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: CircuitSalt.S48, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA384 },
+  { staticId: 14, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B3072, exponent: CircuitExponent.E65537, salt: CircuitSalt.S32, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 15, algorithm: CircuitAlgorithm.RSAPSS, keySize: CircuitKeySize.B2048, exponent: CircuitExponent.E65537, salt: CircuitSalt.S64, curve: null, hashAlgorithm: CircuitHashAlgorithm.HA512 },
+
+  // ── ECDSA ──────────────────────────────────────────────────────────────
+  { staticId: 20, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B256, exponent: null, salt: null, curve: CircuitCurve.SECP256R1,        hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 21, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B256, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP256R1,  hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 22, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B320, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP320R1,  hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 23, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B192, exponent: null, salt: null, curve: CircuitCurve.SECP192R1,        hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 24, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B224, exponent: null, salt: null, curve: CircuitCurve.SECP224R1,        hashAlgorithm: CircuitHashAlgorithm.HA224 },
+  { staticId: 25, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B384, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP384R1,  hashAlgorithm: CircuitHashAlgorithm.HA384 },
+  { staticId: 26, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B512, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP512R1,  hashAlgorithm: CircuitHashAlgorithm.HA512 },
+  { staticId: 27, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B521, exponent: null, salt: null, curve: CircuitCurve.SECP521R1,        hashAlgorithm: CircuitHashAlgorithm.HA512 },
+  { staticId: 28, algorithm: CircuitAlgorithm.ECDSA, keySize: CircuitKeySize.B384, exponent: null, salt: null, curve: CircuitCurve.SECP384R1,        hashAlgorithm: CircuitHashAlgorithm.HA384 },
+];
+
+// Lookup the staticId for a given (algo, keySize, exponent, salt, curve, hashAlgo)
+// tuple. Returns null if no row matches — that means the passport's signature
+// suite isn't supported by Rarimo's published heavy-register circuits.
+export function getSupportedSignatureTypeId(
+  candidate: Omit<CircuitSignatureType, "staticId">,
+): number | null {
+  const match = SUPPORTED_SIGNATURE_TYPES.find(
+    (row) =>
+      row.algorithm === candidate.algorithm &&
+      row.keySize === candidate.keySize &&
+      row.exponent === candidate.exponent &&
+      row.salt === candidate.salt &&
+      row.curve === candidate.curve &&
+      row.hashAlgorithm === candidate.hashAlgorithm,
+  );
+  return match ? match.staticId : null;
+}
+
+// 5 entries (1 RSA + 4 ECDSA) for Active Authentication algorithms. Used only
+// when the passport has a non-empty DG15.
+export const SUPPORTED_AA_TYPES: CircuitAAAlgorithm[] = [
+  // RSA fallback
+  { staticId: 1, algorithm: CircuitAlgorithm.RSA, keySize: CircuitKeySize.B1024, exponent: CircuitExponent.E65537, salt: null, curve: null, hashAlgorithm: null },
+
+  // ECDSA AA variants
+  { staticId: 20, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP256R1,       hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 21, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP256R1, hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 22, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.BRAINPOOLP320R1, hashAlgorithm: CircuitHashAlgorithm.HA256 },
+  { staticId: 23, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP192R1,       hashAlgorithm: CircuitHashAlgorithm.HA160 },
+  { staticId: 24, algorithm: CircuitAlgorithm.ECDSA, keySize: null, exponent: null, salt: null, curve: CircuitCurve.SECP384R1,       hashAlgorithm: CircuitHashAlgorithm.HA384 },
+];
+
+// Match an AA row by (algorithm, hashAlgorithm, curve). Mirrors the iOS
+// SupportRegisterIdentityCircuitAAType.getSupportedSignatureTypeId logic,
+// including its RSA fallback to staticId=1 when no other row matches.
+export function getSupportedAATypeId(
+  candidate: Pick<CircuitAAAlgorithm, "algorithm" | "hashAlgorithm" | "curve">,
+): number | null {
+  const match = SUPPORTED_AA_TYPES.find(
+    (row) =>
+      row.algorithm === candidate.algorithm &&
+      row.hashAlgorithm === candidate.hashAlgorithm &&
+      row.curve === candidate.curve,
+  );
+  if (match) return match.staticId;
+  // iOS fallback: any RSA AA without an exact row defaults to staticId=1.
+  if (candidate.algorithm === CircuitAlgorithm.RSA) return 1;
+  return null;
+}
