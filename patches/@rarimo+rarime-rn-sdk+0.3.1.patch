+// passportHashType field of the suite (used for SHA-block-size lookups).
+import { CircuitPassportHashType } from "./CircuitSuite";
+export function passportHashTypeFromOID(oid) {
+    switch (oid) {
+        case ID_SHA1: return CircuitPassportHashType.SHA1;
+        case ID_SHA224: return CircuitPassportHashType.SHA224;
+        case ID_SHA256: return CircuitPassportHashType.SHA256;
+        case ID_SHA384: return CircuitPassportHashType.SHA384;
+        case ID_SHA512: return CircuitPassportHashType.SHA512;
+        default:
+            throw new Error(`Unsupported passport hash OID: ${oid}`);
+    }
+}
