+// Resolves a passport's SOD into a RegisterIdentityCircuitType suite, which
+// composes into one of the published `registerIdentity_<suite>.json` filenames
+// at https://storage.googleapis.com/rarimo-store/passport-zk-circuits-noir/v0.1.x/.
+//
+// Mirrors:
+//   rarime-ios-app/Rarime/Code/Models/Circuits/RegisterIdentityCircuitType.swift
+//     (the Passport.getRegisterIdentityCircuitType() extension at lines 162-273)
+//
+// The resolver returns null when the passport's signature suite isn't in
+// SUPPORTED_SIGNATURE_TYPES — that's the bail-out signal that Rarimo doesn't
+// have a published heavy-register circuit for this document.
+import { Buffer } from "buffer";
+import { sha1 } from "@noble/hashes/sha1";
+import { sha224, sha256 } from "@noble/hashes/sha256";
+import { sha384, sha512 } from "@noble/hashes/sha512";
+import { AsnConvert } from "@peculiar/asn1-schema";
+import { RSAPublicKey, RsaSaPssParams } from "@peculiar/asn1-rsa";
+import { ECParameters } from "@peculiar/asn1-ecc";
+import { id_ecPublicKey } from "@peculiar/asn1-ecc";
+import { CircuitAlgorithm, CircuitDocumentType, CircuitExponent, CircuitKeySize, CircuitPassportHashType, CircuitSalt, CircuitCurve, passportHashChunkSize, } from "./CircuitSuite";
+import { getSupportedSignatureTypeId, } from "./SupportedCircuits";
+import { fromSodSignatureOID, passportHashTypeFromOID, } from "./SODAlgorithm";
+// OIDs we discriminate on for the slave-cert publicKey algorithm.
+const ID_RSA_ENCRYPTION = "1.2.840.113549.1.1.1";
+// Map ECDSA named-curve OIDs to CircuitCurve. Source: RFC 5480 + Brainpool RFC 5639.
+// Mirrors iOS RegisterIdentityCircuitType.getPublicKeyCurve()'s switch table.
+const CURVE_OID_MAP = {
+    "1.3.132.0.7": CircuitCurve.SECP160R1, // secp160r1
+    "1.2.840.10045.3.1.1": CircuitCurve.SECP192R1, // prime192v1 / P-192
+    "1.3.132.0.33": CircuitCurve.SECP224R1, // secp224r1 / P-224
+    "1.2.840.10045.3.1.7": CircuitCurve.SECP256R1, // prime256v1 / P-256
+    "1.3.132.0.34": CircuitCurve.SECP384R1, // secp384r1 / P-384
+    "1.3.132.0.35": CircuitCurve.SECP521R1, // secp521r1 / P-521
+    "1.3.36.3.3.2.8.1.1.1": CircuitCurve.BRAINPOOLP160R1,
+    "1.3.36.3.3.2.8.1.1.3": CircuitCurve.BRAINPOOLP192R1,
+    "1.3.36.3.3.2.8.1.1.5": CircuitCurve.BRAINPOOLP224R1,
+    "1.3.36.3.3.2.8.1.1.7": CircuitCurve.BRAINPOOLP256R1,
+    "1.3.36.3.3.2.8.1.1.9": CircuitCurve.BRAINPOOLP320R1,
+    "1.3.36.3.3.2.8.1.1.11": CircuitCurve.BRAINPOOLP384R1,
+    "1.3.36.3.3.2.8.1.1.13": CircuitCurve.BRAINPOOLP512R1,
+};
+// Round modulus bit length to the nearest CircuitKeySize bucket. iOS only
+// supports a fixed set; off-spec sizes return null and bubble up as "no row".
+function bitsToCircuitKeySize(bits) {
+    switch (bits) {
+        case 160: return CircuitKeySize.B160;
+        case 192: return CircuitKeySize.B192;
+        case 224: return CircuitKeySize.B224;
+        case 256: return CircuitKeySize.B256;
+        case 320: return CircuitKeySize.B320;
+        case 384: return CircuitKeySize.B384;
+        case 512: return CircuitKeySize.B512;
+        case 521: return CircuitKeySize.B521;
+        case 1024: return CircuitKeySize.B1024;
+        case 2048: return CircuitKeySize.B2048;
+        case 3072: return CircuitKeySize.B3072;
+        case 4096: return CircuitKeySize.B4096;
+        default: return null;
+    }
+}
+// Map raw RSA public exponent integer to the closed CircuitExponent set.
+function bigintToCircuitExponent(e) {
+    switch (e) {
+        case 3n: return CircuitExponent.E3;
+        case 65537n: return CircuitExponent.E65537;
+        case 37187n: return CircuitExponent.E37187;
+        case 58333n: return CircuitExponent.E58333;
+        case 45347n: return CircuitExponent.E45347;
+        case 46271n: return CircuitExponent.E46271;
+        default: return null;
+    }
+}
+function saltLengthToCircuitSalt(salt) {
+    switch (salt) {
+        case 32: return CircuitSalt.S32;
+        case 48: return CircuitSalt.S48;
+        case 64: return CircuitSalt.S64;
+        default: return null;
+    }
+}
+// Pick the document signer cert out of the CMS CertificateSet. SOD usually
+// has exactly one cert (the DSC); we take the first one with a `.certificate`
+// field. Returns null if none.
+export function pickSlaveCertificate(certificates) {
+    for (const choice of certificates) {
+        if (choice.certificate)
+            return choice.certificate;
+    }
+    return null;
+}
+// Extract (algorithm, keySize, exponent, salt, curve) from the slave cert's
+// public key + signature algorithm. The hash component is overlaid by the
+// caller (it comes from the SOD's signing OID, not the cert's pubkey info).
+export function extractSignatureSuiteFromCert(cert) {
+    const spkAlgoOid = cert.tbsCertificate.subjectPublicKeyInfo.algorithm.algorithm;
+    const sigAlgoOid = cert.signatureAlgorithm.algorithm;
+    // RSA family — the cert's signatureAlgorithm OID encodes RSA vs RSA-PSS.
+    // Note: iOS treats all of {rsaEncryption, sha*WithRSAEncryption} as RSA;
+    // RSA-PSS is only when sigAlgoOid === "1.2.840.113549.1.1.10".
+    if (spkAlgoOid === ID_RSA_ENCRYPTION) {
+        const rsaPub = AsnConvert.parse(cert.tbsCertificate.subjectPublicKeyInfo.subjectPublicKey, RSAPublicKey);
+        const modulusBytes = new Uint8Array(rsaPub.modulus);
+        // Strip leading zero (ASN.1 INTEGER sign byte) before measuring bit length.
+        const stripped = modulusBytes[0] === 0x00 ? modulusBytes.subarray(1) : modulusBytes;
+        const bitLen = stripped.length * 8;
+        const exponent = BigInt("0x" + Buffer.from(rsaPub.publicExponent).toString("hex"));
+        let algorithm = CircuitAlgorithm.RSA;
+        let salt = null;
+        if (sigAlgoOid === "1.2.840.113549.1.1.10") {
+            algorithm = CircuitAlgorithm.RSAPSS;
+            // Salt length lives in the cert's signatureAlgorithm.parameters.
+            if (cert.signatureAlgorithm.parameters) {
+                try {
+                    const pssParams = AsnConvert.parse(cert.signatureAlgorithm.parameters, RsaSaPssParams);
+                    salt = saltLengthToCircuitSalt(pssParams.saltLength);
+                }
+                catch (_) {
+                    // Defaults: PKCS#1 v2.1 says missing salt = 20, but no published
+                    // variant uses 20-byte salt; treat as unknown.
+                    salt = null;
+                }
+            }
+        }
+        const keySize = bitsToCircuitKeySize(bitLen);
+        if (!keySize) {
+            throw new Error(`Unsupported RSA modulus length ${bitLen} bits `
+                + `(supported: 1024/2048/3072/4096); extend bitsToCircuitKeySize in SuiteResolver.ts`);
+        }
+        return {
+            algorithm,
+            keySize,
+            exponent: bigintToCircuitExponent(exponent),
+            salt,
+            curve: null,
+        };
+    }
+    // ECDSA — public key algorithm is id-ecPublicKey; named curve in parameters.
+    if (spkAlgoOid === id_ecPublicKey) {
+        if (!cert.tbsCertificate.subjectPublicKeyInfo.algorithm.parameters) {
