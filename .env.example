# Copy to .env.local (gitignored) and fill in. Used by `eas submit` for the
# association's org account. Do NOT commit real values: eas.json references
# these variables rather than the values themselves.

# Org App Store Connect account-holder Apple ID.
EXPO_APPLE_ID=

# --- Auth: pick ONE of the two below ---

# Option A: app-specific password (appleid.apple.com -> Sign-In & Security -> App-Specific Passwords)
EXPO_APPLE_APP_SPECIFIC_PASSWORD=

# Option B: App Store Connect API key (recommended for CI). Generate under the
# org: App Store Connect -> Users and Access -> Integrations -> App Store Connect API.
# Download the .p8 once and keep it out of git (./secrets is gitignored).
# These four are the ones eas.json reads (submit.*.ios). scripts/eas-submit.sh
# refuses to start until all four are set.
RC_ASC_APP_ID=
RC_ASC_API_KEY_PATH=
RC_ASC_API_KEY_ID=
RC_ASC_API_KEY_ISSUER_ID=
