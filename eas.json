{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    // "_comment": "WARNING: the `appleId` below is the personal email of the App Store Connect account holder, baked into git history. If account ownership changes, rotate everywhere this email appears in history (audit pass 2026-05-24 flagged this as H-2). Consider moving to `$EXPO_APPLE_ID` env + `eas submit --apple-id $EXPO_APPLE_ID` in CI before the next ownership change.",
    "testflight": {
      "ios": {
        "appleId": "gnourobi@hotmail.fr"
      }
    },
    "production": {
      "ios": {
        "appleId": "gnourobi@hotmail.fr"
      }
    }
  }
}
