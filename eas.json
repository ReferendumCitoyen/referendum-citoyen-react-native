{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    // "_comment": "Org account (Liberez vous citoyens). ascAppId pins the App Store Connect app (bundle id app.referendumcitoyen.fr) so EAS skips the create step — org accounts need a companyName the CLI can't supply. The ASC API key is a Team key: the private .p8 lives in ./secrets (gitignored); only the non-secret keyId/issuerId are referenced here. EAS reads ascApiKeyPath/Id/IssuerId directly, so submit never prompts for a key.",
    "testflight": {
      "ios": {
        "ascAppId": "6777138213",
        "ascApiKeyPath": "./secrets/AuthKey_5GBUC9445Y.p8",
        "ascApiKeyId": "5GBUC9445Y",
        "ascApiKeyIssuerId": "541a29cf-6f46-4020-bc5b-4608eaf50d48"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6777138213",
        "ascApiKeyPath": "./secrets/AuthKey_5GBUC9445Y.p8",
        "ascApiKeyId": "5GBUC9445Y",
        "ascApiKeyIssuerId": "541a29cf-6f46-4020-bc5b-4608eaf50d48"
      }
    }
  }
}
